{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScoutOutput",
  "type": "object",
  "properties": {
    "domain": {
      "type": "string",
      "description": "The scientific domain searched"
    },
    "papers": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "authors": { "type": "array", "items": { "type": "string" } },
          "year": { "type": "integer" },
          "url": { "type": "string" },
          "domain": { "type": "string" },
          "mechanism_summary": { "type": "string" },
          "ctr_analogy": { "type": "string" },
          "structural_analogy_score": { "type": "number", "minimum": 1, "maximum": 10 },
          "implementation_feasibility_score": { "type": "number", "minimum": 1, "maximum": 10 },
          "novelty_score": { "type": "number", "minimum": 1, "maximum": 10 }
        },
        "required": ["title", "authors", "year", "url", "domain", "mechanism_summary", "ctr_analogy", "structural_analogy_score", "implementation_feasibility_score", "novelty_score"]
      }
    },
    "search_queries_used": {
      "type": "array",
      "items": { "type": "string" },
      "description": "The actual search queries executed"
    }
  },
  "required": ["domain", "papers", "search_queries_used"]
}
